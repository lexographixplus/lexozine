# Neon production database
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

# Neon managed auth
NEON_AUTH_BASE_URL=https://ep-cool-pond-ax00bmnw.neonauth.c-4.us-east-2.aws.neon.tech/neondb/auth
NEON_AUTH_COOKIE_SECRET=replace-with-at-least-32-random-characters

# Cloudinary signed uploads
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=replace-me
NEXT_PUBLIC_CLOUDINARY_API_KEY=replace-me
CLOUDINARY_API_SECRET=replace-me

# Public application origin used for PDF rendering and callbacks
NEXT_PUBLIC_APP_URL=https://your-lexozine-v2-domain.vercel.app

# Canonical public magazine reader origin
NEXT_PUBLIC_READER_ORIGIN=https://read.lexographixplus.com
